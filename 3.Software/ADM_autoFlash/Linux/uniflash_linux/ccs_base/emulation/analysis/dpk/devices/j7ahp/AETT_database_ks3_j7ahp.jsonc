    "g_map_trace_aggr_component_mapping": [
        [
            // Decoder uses the 3 MSBs (128,64,32) to distinguish between trace aggregators

            // MSMC_0 (3MSB master = 7): master ID = 224 + Probe #
            // (as defined in KS3_J7Quad_computer_cluster.docx, 4.2.1 MSMC CPTracer2 Monitoring Points)
            "eTraceAggregator_0",
            [
                {
                    "key": "MODULE$MOD_CPTRACER0$MAPPING$masterid.decoder$*",
                    "value": "StpCPTracer2Decoder"
                },
