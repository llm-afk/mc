  //NOTE This has to be here even if empty else will not initialize the database
  //See comment above in g_map_component_table for the M4 entries. Same comment applies here to the dap_ap_page.
  //This property is duplicated between g_map_component_table and g_map_arm_v7m4
  //The dwt, fpb, itm, cti,etm addresses are from the Blazar Functional Spec from AM64_blazar_fs_spec_v1p0p13.pdf which is pointed to from the AM62 M4.
  //NOTE THese are pretty much the same across the M4s across all devices
  "g_map_aggr_to_trace_src": [
    [
      "eTraceAggregator_0",
      {
        //This is just an Enum we use for the main clock domain probes aggregator
        //Should we introduce another one just for the Main CLock domain?
        "detail": "eSttdCpt2Soc",
        "sources": [
          "eCpTracer2_Probe_0",
          "eCpTracer2_Probe_1",
          "eCpTracer2_Probe_2",
          "eCpTracer2_Probe_3",
          "eCpTracer2_Probe_4",
          "eCpTracer2_Probe_5",
          "eCpTracer2_Probe_6",
          "eCpTracer2_Probe_7",
          "eCpTracer2_Probe_8",
          "eCpTracer2_Probe_9"
        ]
      }
    ],
    [
      "eTraceAggregator_1",
      {
        "detail": "eSttdCpt2Mcu",
        "sources": [
            "eCpTracer2_Probe_10",
            "eCpTracer2_Probe_11",
            "eCpTracer2_Probe_12",
            "eCpTracer2_Probe_13"
        ]
      }
    ],
    [
      "eTraceAggregator_2",
      {
        "detail": "eSttdCpt2Mcu",
        "sources": [
          "eCpTracer2_Probe_14",
          "eCpTracer2_Probe_15"
        ]
      }
    ]
  ],
  "g_vec_xtrig_routes": [
    // { direction, type, comp_id, infra_type, infra_id, trig_idnex, channel_group }

    // EVENT : DEBUG HALT
    { "directon": "eXtrigEvent", "type": "eXtrigHalted", "comp_id": "eArmv8a_0", "infra_type": "eXtrigInfraCS", "infra_id": "eCorePacCsCti_0", "trig_index": 0, "channel_group": 0     }, //eCorePacArmv8x2_CorePac_0
    { "directon": "eXtrigEvent", "type": "eXtrigHalted", "comp_id": "eArmv8a_1", "infra_type": "eXtrigInfraCS", "infra_id": "eCorePacCsCti_1", "trig_index": 0, "channel_group": 0     },
    { "directon": "eXtrigEvent", "type": "eXtrigHalted", "comp_id": "eArmv7m4_0", "infra_type": "eXtrigInfraCS", "infra_id": "eCorePacCsCti_2", "trig_index": 0, "channel_group": 0     },  // SMS0_TIFS
   
    // EVENT : SYNC RUN
    { "directon": "eXtrigEvent", "type": "eXtrigSyncRunEvent", "comp_id": "eArmv8a_0", "infra_type": "eXtrigInfraCS", "infra_id": "eDebugSsCsCti_0", "trig_index": 0, "channel_group": 0     }, //eCorePacArmv8x2_CorePac_0
    { "directon": "eXtrigEvent", "type": "eXtrigSyncRunEvent", "comp_id": "eArmv8a_1", "infra_type": "eXtrigInfraCS", "infra_id": "eDebugSsCsCti_0", "trig_index": 0, "channel_group": 0     },
    { "directon": "eXtrigEvent", "type": "eXtrigSyncRunEvent", "comp_id": "eArmv7m4_0", "infra_type": "eXtrigInfraCS", "infra_id": "eDebugSsCsCti_0", "trig_index": 0, "channel_group": 0     },  // SMS0_TIFS
   
    // ACTION : HALT REQUEST
    { "directon": "eXtrigAction", "type": "eXtrigHaltReq", "comp_id": "eArmv8a_0", "infra_type": "eXtrigInfraCS", "infra_id": "eCorePacCsCti_0", "trig_index": 0, "channel_group": 0     }, //eCorePacArmv8x2_CorePac_0
    { "directon": "eXtrigAction", "type": "eXtrigHaltReq", "comp_id": "eArmv8a_1", "infra_type": "eXtrigInfraCS", "infra_id": "eCorePacCsCti_1", "trig_index": 0, "channel_group": 0     },
    { "directon": "eXtrigAction", "type": "eXtrigHaltReq", "comp_id": "eArmv7m4_0", "infra_type": "eXtrigInfraCS", "infra_id": "eCorePacCsCti_2", "trig_index": 0, "channel_group": 0     },  // SMS0_TIFS
    
    // ACTION : RUN REQUEST
    { "directon": "eXtrigAction", "type": "eXtrigSyncRunAction", "comp_id": "eArmv8a_0", "infra_type": "eXtrigInfraCS", "infra_id": "eCorePacCsCti_0", "trig_index": 1, "channel_group": 0     }, //eCorePacArmv8x2_CorePac_0
    { "directon": "eXtrigAction", "type": "eXtrigSyncRunAction", "comp_id": "eArmv8a_1", "infra_type": "eXtrigInfraCS", "infra_id": "eCorePacCsCti_1", "trig_index": 1, "channel_group": 0     },
    { "directon": "eXtrigAction", "type": "eXtrigSyncRunAction", "comp_id": "eArmv7m4_0", "infra_type": "eXtrigInfraCS", "infra_id": "eCorePacCsCti_2", "trig_index": 7, "channel_group": 0     },  // SMS0_TIFS
    
    // ACTION : FLUSH REQUEST
    { "directon": "eXtrigAction", "type": "eXtrigTbrFlushIn", "comp_id": "eDebugCellTbr_0", "infra_type": "eXtrigInfraCS", "infra_id": "eDebugCellCsCti_0", "trig_index": 1, "channel_group": 0     },
