          "eCpTracer2_Probe_10",
          "eCpTracer2_Probe_11",
          "eCpTracer2_Probe_12",
          "eCpTracer2_Probe_13",
        
          //WKUP_SYSCLK Clock Domain Probes--------
          "eTraceAggregator_2",
          "eCpTracer2_Probe_14",
          "eCpTracer2_Probe_15"

          //---------------------------------------
        ]
      }
    ]
  ],

